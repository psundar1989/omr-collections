APP_NAME="Handmade Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=handmade_shop
DB_USERNAME=handmade
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Public base URL of uploads with MEDIA_DISK=s3: your CloudFront domain, e.g. https://d111111abcdef8.cloudfront.net
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- Shop -------------------------------------------------------------
# Storefront origin(s) allowed to call the API (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Public storefront URL. WhatsApp order messages link to catalogue photos on this domain, so
# set it to the production HTTPS domain: image links on localhost or http:// are left out.
FRONTEND_URL=http://localhost:3000
SHOP_CURRENCY=INR
SHOP_MAX_ORDER_QTY=50
# Media disk for uploads: "public" (local) now, "s3" later (set AWS_* above)
MEDIA_DISK=public
# Public URL of storage/app/public (defaults to APP_URL/storage). Set it in production,
# e.g. https://api.omrcollections.in/storage, so upload URLs never point at localhost.
# With MEDIA_DISK=s3 the URL comes from AWS_URL instead (use your HTTPS CDN or bucket domain).
PUBLIC_STORAGE_URL=

# Optional Meta WhatsApp Cloud API: sends each product photo as an image to the customer's
# WhatsApp number (and WHATSAPP_CLOUD_NOTIFY_NUMBERS) when an order is placed. Off unless
# token, phone number ID and template are set.
# Needs an approved template with an IMAGE header and a body with 9 variables:
# {{1}} order number, {{2}} product (with colour / size), {{3}} SKU, {{4}} unit price,
# {{5}} quantity, {{6}} product link, {{7}} customer name and phone, {{8}} delivery address,
# {{9}} order total.
# Also needs a running queue worker, and images on a public HTTPS URL in JPEG or PNG format
# (uploads are served from PUBLIC_STORAGE_URL, catalogue photos from FRONTEND_URL).
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_TEMPLATE=
WHATSAPP_CLOUD_TEMPLATE_LANGUAGE=en
WHATSAPP_CLOUD_API_VERSION=v26.0
# Shop / admin numbers that also receive every order photo with the customer's details, e.g. 919876543210
WHATSAPP_CLOUD_NOTIFY_NUMBERS=

# First admin account (created/updated by `php artisan db:seed`)
ADMIN_EMAIL=admin@example.in
ADMIN_PASSWORD=ChangeMe@123
# Seed the demo catalogue in production too (default: only non-production)
SEED_DEMO_DATA=false
